<?xml version="1.0" encoding="UTF-8"?>
<testcase expect="invalid" xmlns="https://doi.org/10.5281/zenodo.5679629#">
  <label>The sch:phase/@from attribute does not change the context for evaluating @documents</label>
  <schemas>
    <schema><sch:schema defaultPhase="phase-1" xmlns:sch="http://purl.oclc.org/dsdl/schematron">
      <sch:phase id="phase-1" from="element">
        <sch:active pattern="pattern-1"/>
      </sch:phase>
      <sch:pattern documents="element/@secondary" id="pattern-1">
        <sch:rule context="/">
          <sch:report test="root"/>
        </sch:rule>
      </sch:pattern>
    </sch:schema></schema>
  </schemas>
  <documents>
    <document filename="document.xml">
      <element secondary="document-02.xml" xmlns=""/>
    </document>
    <document filename="document-02.xml">
      <root xmlns=""/>
    </document>
  </documents>
</testcase>