<?xml version="1.0" encoding="UTF-8"?>
<testcase expect="invalid" xmlns="https://doi.org/10.5281/zenodo.5679629#">
  <testcase:label xmlns:testcase="https://doi.org/10.5281/zenodo.5679629#">When an abstract group is instantiated, placeholders are replaced in the sch:let @value attribute of a group-scoped variable</testcase:label>
  <schemas>
    <schema><sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron">
      <sch:group abstract="true" id="abstract-group">
        <sch:let name="variable" value="$expression"/>
        <sch:rule context="/">
          <sch:assert test="false()">
            <sch:value-of select="$variable"/>
          </sch:assert>
        </sch:rule>
      </sch:group>
      <sch:group is-a="abstract-group">
        <sch:param name="expression" value="name(*[1])"/>
      </sch:group>
    </sch:schema></schema>
  </schemas>
  <documents>
    <document filename="document.xml">
      <element xmlns=""/>
    </document>
  </documents>
  <assertions xmlns:svrl="http://purl.oclc.org/dsdl/svrl">
    <assertion assert="//svrl:failed-assert/svrl:text = 'element'"/>
  </assertions>
</testcase>