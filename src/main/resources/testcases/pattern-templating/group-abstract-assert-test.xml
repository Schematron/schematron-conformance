<?xml version="1.0" encoding="UTF-8"?>
<testcase expect="invalid" xmlns="https://doi.org/10.5281/zenodo.5679629#">
  <testcase:label xmlns:testcase="https://doi.org/10.5281/zenodo.5679629#">When an abstract group is instantiated, placeholders are replaced in the sch:assert @test attribute</testcase:label>
  <schemas>
    <schema><sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron">
      <sch:group abstract="true" id="abstract-group">
        <sch:rule context="/">
          <sch:assert test="$expression"/>
        </sch:rule>
      </sch:group>
      <sch:group is-a="abstract-group">
        <sch:param name="expression" value="false()"/>
      </sch:group>
    </sch:schema></schema>
  </schemas>
  <documents>
    <document filename="document.xml">
      <element xmlns=""/>
    </document>
  </documents>
</testcase>