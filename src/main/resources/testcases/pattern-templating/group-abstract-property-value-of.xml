<?xml version="1.0" encoding="UTF-8"?>
<testcase expect="invalid" xmlns="https://doi.org/10.5281/zenodo.5679629#">
  <testcase:label xmlns:testcase="https://doi.org/10.5281/zenodo.5679629#">When an abstract group is instantiated, placeholders are replaced in the sch:value-of @select attribute inside a sch:property</testcase:label>
  <schemas>
    <schema><sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron">
      <sch:group abstract="true" id="abstract-group">
        <sch:rule context="/">
          <sch:assert test="false()" properties="prop-1"/>
        </sch:rule>
      </sch:group>
      <sch:group is-a="abstract-group">
        <sch:param name="expression" value="'foobar'"/>
      </sch:group>
      <sch:properties>
        <sch:property id="prop-1">
          <sch:value-of select="$expression"/>
        </sch:property>
      </sch:properties>
    </sch:schema></schema>
  </schemas>
  <documents>
    <document filename="document.xml">
      <element xmlns=""/>
    </document>
  </documents>
  <assertions xmlns:svrl="http://purl.oclc.org/dsdl/svrl">
    <assertion assert="normalize-space(//svrl:failed-assert/svrl:property-reference/svrl:text) = 'foobar'"/>
  </assertions>
</testcase>