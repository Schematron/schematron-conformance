<?xml version="1.0" encoding="UTF-8"?>
<testcase expect="invalid" xmlns="https://doi.org/10.5281/zenodo.5679629#">
  <testcase:label xmlns:testcase="https://doi.org/10.5281/zenodo.5679629#">When an abstract group is instantiated, placeholders are replaced in the sch:group @documents attribute</testcase:label>
  <schemas>
    <sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron">
      <sch:group id="abstract-group" abstract="true" documents="$expression">
        <sch:rule context="/">
          <sch:report test="root"/>
        </sch:rule>
      </sch:group>
      <sch:group is-a="abstract-group">
        <sch:param name="expression" value="/element/@secondary"/>
      </sch:group>
    </sch:schema>
  </schemas>
  <documents>
    <document filename="document.xml">
      <element secondary="document-02.xml" xmlns=""/>
    </document>
    <document filename="document-02.xml">
      <root xmlns=""/>
    </document>
  </documents>
</testcase>
