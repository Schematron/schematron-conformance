<?xml version="1.0" encoding="UTF-8"?>
<testcase expect="invalid" xmlns="https://doi.org/10.5281/zenodo.5679629#">
  <label>Top-level sch:extends incorporates external definitions from a library</label>
  <schemas>
    <schema><sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron">
      <sch:extends href="library.sch"/>
    </sch:schema></schema>
  </schemas>
  <documents>
    <document filename="document.xml">
      <element xmlns=""/>
    </document>
    <document filename="library.sch">
      <sch:library xmlns:sch="http://purl.oclc.org/dsdl/schematron">
        <sch:pattern>
          <sch:rule context="/">
            <sch:assert test="false()"/>
          </sch:rule>
        </sch:pattern>
      </sch:library>
    </document>
  </documents>
</testcase>