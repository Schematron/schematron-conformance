<?xml version="1.0" encoding="UTF-8"?>
<testcase expect="invalid" phase="#DEFAULT" xmlns="https://doi.org/10.5281/zenodo.5679629#">
  <label>When the phase #DEFAULT is given, the processor uses the phase given in @defaultPhase</label>
  <schemas>
    <schema><sch:schema defaultPhase="phase" xmlns:sch="http://purl.oclc.org/dsdl/schematron">
      <sch:phase id="phase">
        <sch:active pattern="fail"/>
      </sch:phase>
      <sch:pattern id="fail">
        <sch:rule context="*">
          <sch:assert test="false()"/>
        </sch:rule>
      </sch:pattern>
      <sch:pattern id="pass">
        <sch:rule context="*">
          <sch:assert test="true()"/>
        </sch:rule>
      </sch:pattern>
    </sch:schema></schema>
  </schemas>
  <documents>
    <document filename="document.xml">
      <element xmlns=""/>
    </document>
  </documents>
</testcase>