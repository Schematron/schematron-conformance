<?xml version="1.0" encoding="UTF-8"?>
<testcase expect="invalid" xmlns="https://doi.org/10.5281/zenodo.5679629#">
  <label>The sch:name element expands into the name of node selected by the assertion's @subject attribute if no @path is present</label>
  <schemas>
    <schema><sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron">
      <sch:pattern>
        <sch:rule context="/element">
          <sch:report test="true()" subject="@attribute">
            <sch:name/>
          </sch:report>
        </sch:rule>
      </sch:pattern>
    </sch:schema></schema>
  </schemas>
  <documents>
    <document filename="document.xml">
      <element attribute="value" xmlns=""/>
    </document>
  </documents>
  <assertions xmlns:svrl="http://purl.oclc.org/dsdl/svrl">
    <assertion assert="normalize-space(//svrl:successful-report) = 'attribute'"/>
  </assertions>
</testcase>