<?xml version="1.0" encoding="UTF-8"?>
<testcase expect="invalid" xmlns="https://doi.org/10.5281/zenodo.5679629#">
  <label>The svrl:active-group/@role attribute contains the role of the active group</label>
  <schemas>
    <schema><sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron">
      <sch:group role="warning">
        <sch:rule context="/">
          <sch:report test="true()"/>
        </sch:rule>
      </sch:group>
    </sch:schema></schema>
  </schemas>
  <documents>
    <document filename="document.xml">
      <document xmlns=""/>
    </document>
  </documents>
  <assertions xmlns:svrl="http://purl.oclc.org/dsdl/svrl">
    <assertion assert="//svrl:active-group[@role = 'warning']"/>
  </assertions>
</testcase>