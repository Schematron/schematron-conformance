<?xml version="1.0" encoding="UTF-8"?>
<testcase expect="invalid" xmlns="https://doi.org/10.5281/zenodo.5679629#">
  <label>The svrl:failed-assert/@flag attribute contains the flag of the failed assertion</label>
  <schemas>
    <schema><sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron">
      <sch:let name="flag" value="'dynamic'"/>
      <sch:pattern>
        <sch:rule context="/">
          <sch:assert test="false()" flag="$flag"/>
        </sch:rule>
      </sch:pattern>
    </sch:schema></schema>
  </schemas>
  <documents>
    <document filename="document.xml">
      <document xmlns=""/>
    </document>
  </documents>
  <assertions xmlns:svrl="http://purl.oclc.org/dsdl/svrl">
    <assertion assert="//svrl:failed-assert/@flag = 'dynamic'"/>
  </assertions>
</testcase>