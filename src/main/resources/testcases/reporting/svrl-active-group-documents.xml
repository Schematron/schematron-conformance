<?xml version="1.0" encoding="UTF-8"?>
<testcase expect="invalid" xmlns="https://doi.org/10.5281/zenodo.5679629#">
  <label>The svrl:active-group/@documents attribute contains the value of the sch:group/@documents attribute</label>
  <schemas>
    <sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron">
      <sch:group documents="/element/@secondary">
        <sch:rule context="/">
          <sch:report test="root"/>
        </sch:rule>
      </sch:group>
    </sch:schema>
  </schemas>
  <documents>
    <document filename="document.xml">
      <element secondary="document-02.xml" xmlns=""/>
    </document>
    <document filename="document-02.xml">
      <root xmlns=""/>
    </document>
  </documents>
  <assertions xmlns:svrl="http://purl.oclc.org/dsdl/svrl">
    <assertion assert="//svrl:active-group[@documents = '/element/@secondary']"/>
  </assertions>
</testcase>
