<?xml version="1.0" encoding="UTF-8"?>
<testcase expect="invalid" xmlns="https://doi.org/10.5281/zenodo.5679629#">
  <label xmlns:testcase="https://doi.org/10.5281/zenodo.5679629#">The svrl:active-group/@documents attribute contains the URIs of the primary document if there are no subordinate documents</label>
  <schemas>
    <sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron">
      <sch:group>
        <sch:rule context="/">
          <sch:report test="true()"/>
        </sch:rule>
      </sch:group>
    </sch:schema>
  </schemas>
  <documents>
    <document filename="document.xml">
      <document xmlns=""/>
    </document>
  </documents>
  <assertions xmlns:svrl="http://purl.oclc.org/dsdl/svrl">
    <assertion assert="contains(//svrl:active-group/@documents, 'document.xml')"/>
  </assertions>
</testcase>
