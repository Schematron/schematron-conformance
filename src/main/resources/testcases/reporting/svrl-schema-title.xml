<?xml version="1.0" encoding="UTF-8"?>
<testcase expect="invalid" xmlns="https://doi.org/10.5281/zenodo.5679629#">
  <label>The sch:schema/sch:title element is reported as a svrl:schematron-output/@title attribute</label>
  <schemas>
    <schema><sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron">
      <sch:title>Title</sch:title>
      <sch:pattern>
        <sch:rule context="/">
          <sch:assert test="false()"/>
        </sch:rule>
      </sch:pattern>
    </sch:schema></schema>
  </schemas>
  <documents>
    <document filename="document.xml">
      <document xmlns=""/>
    </document>
  </documents>
  <assertions xmlns:svrl="http://purl.oclc.org/dsdl/svrl">
    <assertion assert="/svrl:schematron-output[@title = 'Title']"/>
  </assertions>
</testcase>