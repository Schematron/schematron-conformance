<?xml version="1.0" encoding="UTF-8"?>
<testcase expect="invalid" xmlns="https://doi.org/10.5281/zenodo.5679629#">
  <label>The content of the sch:group/sch:title element is reported in a svrl:active-group/@name attribute</label>
  <schemas>
    <sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron">
      <sch:group>
        <sch:title>Group</sch:title>
        <sch:rule context="/">
          <sch:assert test="false()"/>
        </sch:rule>
      </sch:group>
    </sch:schema>
  </schemas>
  <documents>
    <document filename="document.xml">
      <document xmlns=""/>
    </document>
  </documents>
  <assertions xmlns:svrl="http://purl.oclc.org/dsdl/svrl">
    <assertion assert="/svrl:schematron-output/svrl:active-group[@name = 'Group']"/>
  </assertions>
</testcase>
