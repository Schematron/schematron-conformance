<?xml version="1.0" encoding="UTF-8"?>
<testcase expect="invalid" xmlns="https://doi.org/10.5281/zenodo.5679629#">
  <label>The sch:value-of element expands into the value of evaluating the expression in @select within the context of the node selected by the rule's @subject attribute</label>
  <schemas>
    <sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron">
      <sch:pattern>
        <sch:rule context="child" subject="..">
          <sch:report test="true()">
            <sch:value-of select="local-name()"/>
          </sch:report>
        </sch:rule>
      </sch:pattern>
    </sch:schema>
  </schemas>
  <documents>
    <document filename="document.xml">
      <root xmlns="">
        <child/>
      </root>
    </document>
  </documents>
  <assertions xmlns:svrl="http://purl.oclc.org/dsdl/svrl">
    <assertion assert="normalize-space(//svrl:successful-report) = 'root'"/>
  </assertions>
</testcase>
