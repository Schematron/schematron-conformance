<?xml version="1.0" encoding="UTF-8"?>
<testcase expect="invalid" xmlns="https://doi.org/10.5281/zenodo.5679629#">
  <label>The @value attribute of the sch:dir element is reported as @dir attribute on the svrl:dir element</label>
  <schemas>
    <schema><sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron">
      <sch:pattern>
        <sch:rule context="/">
          <sch:assert test="false()">
            <sch:dir value="rtl">direction</sch:dir>
          </sch:assert>
        </sch:rule>
      </sch:pattern>
    </sch:schema></schema>
  </schemas>
  <documents>
    <document filename="document.xml">
      <document xmlns=""/>
    </document>
  </documents>
  <assertions xmlns:svrl="http://purl.oclc.org/dsdl/svrl">
    <assertion assert="//svrl:dir[@dir = 'rtl']"/>
  </assertions>
</testcase>